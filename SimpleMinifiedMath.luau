umber,number)if x~=x then return NAN,NAN end if x==HUGE or x==-HUGE then return x,0 end const int:number=Math.Trunc(x)const frac:number=x-int return int,frac end function Math.Exp(x:number):number if x~=x then return NAN end if x==HUGE then return HUGE end if x==-HUGE then return 0 end if x==0 then return 1 end const k:number=Math.Floor(x/LN2+0.5)const r:number=x-k*LN2 local term:number=1 local sum:number=1 for i:number=1,25 do term*=r/i sum+=term if Math.Fabs(term)<1e-16 then break end end return sum*(2^k)end function Math.Log(x:number):number if x<0 or x~=x then return NAN end if x==0 then return-HUGE end if x==HUGE then return HUGE end local k:number=0 while x>2 do x/=2 k+=1 end while x<1 do x*=2 k-=1 end const y:number=(x-1)/(x+1)const y2:number=y*y local term:number=y local sum:number=0 for i:number=1,33,2 do sum+=term/i term*=y2 end return 2*sum+k*LN2 end function Math.Log10(x:number):number return Math.Log(x)/LN10 end function Math.Pow(x:number,y:number):number if y==0 then return 1 end if x==0 and y>0 then return 0 end if x<0 and Math.Fmod(y,1)~=0 then return NAN end if x<0 and Math.Fmod(y,1)==0 then const result:number=Math.Exp(y*Math.Log(Math.Fabs(x)))return Math.Fmod(Math.Fabs(y),2)==1 and-result or result end return Math.Exp(y*Math.Log(x))end function Math.Sqrt(x:number):number if x<0 or x~=x then return NAN end if x==0 or x==HUGE then return x end local val:number=x>1 and x or 1 for _=1,20 do val=0.5*(val+x/val)end return val end function Math.Sin(x:number):number if x~=x or x==HUGE or x==-HUGE then return NAN end x=NormalizeAngle(x)const x2:number=x*x local term:number=x local sum:number=x for i:number=3,21,2 do term=-term*x2/(i*(i-1))sum+=term end return sum end function Math.Cos(x:number):number if x~=x or x==HUGE or x==-HUGE then return NAN end x=NormalizeAngle(x)const x2:number=x*x local term:number=1 local sum:number=1 for i:number=2,20,2 do term=-term*x2/(i*(i-1))sum+=term end return sum end function Math.Tan(x:number):number const c:number=Math.