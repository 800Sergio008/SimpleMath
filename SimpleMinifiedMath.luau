nction Math.Remap(value:number,inputStart:number,inputEnd:number,outputStart:number,outputEnd:number):number if inputStart==inputEnd then return outputStart end return(value-inputStart)/(inputEnd-inputStart)*(outputEnd-outputStart)+outputStart end function Math.Noise(x:number):number const fl:number=Math.Floor(x)const X:number=Math.Fabs(fl)%256 x-=fl const u:number=x*x*(3-2*x)return Math.Remap(u,0,1,Grad(X,x),Grad(X+1,x-1))end function Math.Sign(n:number):number if n==0 or n~=n then return n end return n<0 and-1 or 1 end Math.VERSION="1.0.0"table.freeze(Math)return Math
